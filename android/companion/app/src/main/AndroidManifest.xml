<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pinky on the phone itself talks to the AI model the person chose,
         and fetches its updates from Pinky's releases. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Installing an update from Pinky's releases (UpdateInstall), after
         Android asks the person. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The debug page's test notification, and the notification that takes
         the Wireless debugging pairing code (Pairing): asked for only when
         the person starts pairing on Settings › Background screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android's own dialog to lift Pinky's battery limits (Battery), so
         that a long task on the phone is not stopped in the background.
         Only Pinky's screens for tasks on the phone (on_phone_ui) ask.
         Pinky is not in Google Play, whose policy limits this. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Lets the service resolve the display name of launchable apps, and
         Pinky on the phone list and open them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pinky">

        <!-- The debug page, for Pinky's device tests: no launcher entry
             (am start -n <package>/app.pinky.companion.MainActivity). Its
             own process, like any app Pinky reads: the accessibility cache
             does not refresh windows of the service's own process. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:process=":debug" />

        <!-- Pinky's screen, its one launcher entry: tasks on the phone
             itself. In its own process too: the service must see it to
             keep agents off it. -->
        <activity
            android:name=".TaskActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Its settings, opened only from it, in its process. -->
        <activity
            android:name=".SettingsActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:label="@string/phone_settings"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen"
            android:windowSoftInputMode="adjustResize" />

        <!-- Its history and a task of it, opened only from it, in its
             process. -->
        <activity
            android:name=".HistoryActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:label="@string/phone_activity"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen" />
        <activity
            android:name=".MemoryActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:label="@string/phone_memory"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen" />
        <activity
            android:name=".PastTaskActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:label="@string/phone_activity"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen" />

        <!-- Settings › Background screen, opened only from Settings, in its
             process. -->
        <activity
            android:name=".BackgroundActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:label="@string/phone_bg_title"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen"
            android:windowSoftInputMode="adjustResize" />

        <!-- Takes the pairing code typed into the pairing notification's
             reply box (Pairing), in the screens' process. Only this app's
             own PendingIntent reaches it. -->
        <receiver
            android:name=".PairingReceiver"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:process=":ui" />

        <!-- Hears how an update from Pinky's releases went (UpdateInstall). -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:enabled="@bool/on_phone_ui"
            android:exported="false" />

        <service
            android:name=".PinkyAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
